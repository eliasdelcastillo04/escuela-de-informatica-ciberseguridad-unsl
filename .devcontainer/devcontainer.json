{
  "name": "Laboratorio de Seguridad Web - Purple Team",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "postCreateCommand": "chmod +x mvnw && ./mvnw dependency:go-offline -B",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Laboratorio Seguridad Web",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack"
      ]
    }
  }
}
